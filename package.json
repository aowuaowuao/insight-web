{
  "name": "insight-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "智能化信息聚合与检索前端（Vite + Vue 3 + TypeScript）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .ts,.vue --fix",
    "lint:style": "stylelint \"src/**/*.{css,vue}\"",
    "lint:style:fix": "stylelint \"src/**/*.{css,vue}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,json,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "pinia": "^3.0.0",
    "vue": "^3.5.45",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.1",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^16.2.7",
    "postcss-html": "^2.0.0",
    "prettier": "^3.10.1",
    "stylelint": "^18.0.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,vue}": [
      "stylelint --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
